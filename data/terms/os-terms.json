      "chapterName": "deadlocks"
    },
    {
      "id": "os-ch08-term-011",
      "termEn": "deadlock detection",
      "termCn": "死锁检测",
      "explanationCn": "允许死锁发生，然后通过检测算法判断系统是否已经死锁。",
      "explanationEn": "",
      "chapterId": "ch08",
      "chapterName": "deadlocks"
    },
    {
      "id": "os-ch08-term-012",
      "termEn": "recovery scheme",
      "termCn": "死锁恢复方案",
      "explanationCn": "检测到死锁后采取措施恢复系统运行。",
      "explanationEn": "",
      "chapterId": "ch08",
      "chapterName": "deadlocks"
    },
    {
      "id": "os-ch08-term-013",
      "termEn": "process termination",
      "termCn": "进程终止",
      "explanationCn": "通过终止一个或多个死锁进程来解除死锁。",
      "explanationEn": "",
      "chapterId": "ch08",
      "chapterName": "deadlocks"
    },
    {
      "id": "os-ch08-term-014",
      "termEn": "resource preemption",
      "termCn": "资源抢占",
      "explanationCn": "通过强制回收某些资源并重新分配来解除死锁。",
      "explanationEn": "",
      "chapterId": "ch08",
      "chapterName": "deadlocks"
    },
    {
      "id": "os-ch09-term-001",
      "termEn": "logical address",
      "termCn": "逻辑地址",
      "explanationCn": "也叫虚拟地址，是程序生成的地址。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-002",
      "termEn": "physical address",
      "termCn": "物理地址",
      "explanationCn": "内存硬件中真实的地址。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-003",
      "termEn": "dynamic loading",
      "termCn": "动态装入",
      "explanationCn": "程序模块在真正需要执行时才装入内存。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
