      "termEn": "dynamic linking",
      "termCn": "动态链接",
      "explanationCn": "程序运行时才把库函数或模块链接进来。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
