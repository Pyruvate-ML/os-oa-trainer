      "chapterName": "deadlocks"
    },
    {
      "id": "os-ch08-term-008",
      "termEn": "deadlock avoidance",
      "termCn": "死锁避免",
      "explanationCn": "在资源分配前进行判断，避免系统进入不安全状态。",
      "explanationEn": "",
      "chapterId": "ch08",
      "chapterName": "deadlocks"
    },
    {
