      "chapterId": "ch10",
      "chapterName": "virtual memory"
    },
    {
      "id": "os-ch10-term-009",
      "termEn": "effective access time",
      "termCn": "有效访问时间",
      "explanationCn": "考虑 TLB 命中率、缺页率等因素后的平均访存时间。",
      "explanationEn": "",
      "chapterId": "ch10",
      "chapterName": "virtual memory"
    },
    {
      "id": "os-ch10-term-010",
      "termEn": "page replacement",
      "termCn": "页面置换",
      "explanationCn": "当内存没有空闲页框时，选择某个页面换出。",
