      "chapterId": "ch10",
      "chapterName": "virtual memory"
    },
    {
      "id": "os-ch10-term-008",
      "termEn": "page fault",
      "termCn": "缺页中断",
      "explanationCn": "访问的页面不在内存时产生的异常。",
