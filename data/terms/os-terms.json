      "chapterId": "ch10",
      "chapterName": "virtual memory"
    },
    {
      "id": "os-ch10-term-007",
      "termEn": "valid-invalid bit",
      "termCn": "有效/无效位",
      "explanationCn": "页表项中表示该页是否在内存或是否合法的标志位。",
