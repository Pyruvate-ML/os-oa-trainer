    {
      "id": "os-ch08-term-002",
      "termEn": "mutual exclusion",
      "termCn": "互斥",
      "explanationCn": "某些资源一次只能被一个进程占有。",
      "explanationEn": "",
      "chapterId": "ch08",
      "chapterName": "deadlocks"
    },
