    {
      "id": "os-ch09-term-011",
      "termEn": "best fit",
      "termCn": "最佳适应算法",
      "explanationCn": "选择能够满足需求且剩余空间最小的空闲分区。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-012",
      "termEn": "worst fit",
      "termCn": "最坏适应算法",
      "explanationCn": "选择最大的空闲分区进行分配。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-013",
