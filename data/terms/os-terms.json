      "chapterName": "deadlocks"
    },
    {
      "id": "os-ch08-term-005",
      "termEn": "circular wait",
      "termCn": "循环等待",
      "explanationCn": "存在一个进程循环链，每个进程都在等待下一个进程占有的资源。",
      "explanationEn": "",
      "chapterId": "ch08",
      "chapterName": "deadlocks"
    },
    {
      "id": "os-ch08-term-006",
      "termEn": "resource-allocation graph",
      "termCn": "资源分配图",
      "explanationCn": "用图形表示进程和资源之间的请求、分配关系。",
