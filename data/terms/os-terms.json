      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-018",
      "termEn": "page table",
      "termCn": "页表",
      "explanationCn": "保存逻辑页号到物理页框号映射关系的数据结构。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-019",
      "termEn": "associative register",
      "termCn": "联想寄存器",
      "explanationCn": "在内存管理中通常指 TLB，用于加快页表查询。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-020",
      "termEn": "TLB",
      "termCn": "快表",
      "explanationCn": "保存近期使用的页表项，以提高地址转换速度。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-021",
      "termEn": "two-level page-table",
      "termCn": "二级页表",
      "explanationCn": "把页表再分页，减少连续存放大页表的内存压力。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-022",
      "termEn": "hashed page table",
      "termCn": "哈希页表",
      "explanationCn": "利用哈希函数根据页号查找页表项，常用于大地址空间。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-023",
      "termEn": "inverted page table",
      "termCn": "倒置页表",
      "explanationCn": "按物理页框建立表项，每个页框对应一个表项。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-024",
      "termEn": "segmentation",
      "termCn": "分段",
      "explanationCn": "把程序按逻辑意义划分为代码段、数据段、堆栈段等。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-025",
      "termEn": "segmentation with paging",
      "termCn": "段页式管理",
      "explanationCn": "先分段再分页，结合分段的逻辑性和分页的离散分配优点。",
      "explanationEn": "",
      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch10-term-001",
      "termEn": "virtual memory",
      "termCn": "虚拟内存",
      "explanationCn": "使程序看到的地址空间可以大于实际物理内存。",
      "explanationEn": "",
      "chapterId": "ch10",
      "chapterName": "virtual memory"
    },
    {
      "id": "os-ch10-term-002",
      "termEn": "physical memory",
      "termCn": "物理内存",
      "explanationCn": "计算机实际安装的主存空间。",
      "explanationEn": "",
      "chapterId": "ch10",
      "chapterName": "virtual memory"
    },
    {
      "id": "os-ch10-term-003",
      "termEn": "locality of reference",
      "termCn": "局部性原理",
      "explanationCn": "程序在一段时间内倾向于访问相近或最近使用过的地址。",
      "explanationEn": "",
      "chapterId": "ch10",
      "chapterName": "virtual memory"
    },
    {
      "id": "os-ch10-term-004",
      "termEn": "demand paging",
      "termCn": "请求分页",
      "explanationCn": "只有当页面被访问且不在内存时才调入页面。",
      "explanationEn": "",
      "chapterId": "ch10",
      "chapterName": "virtual memory"
    },
    {
      "id": "os-ch10-term-005",
      "termEn": "demand segmentation",
      "termCn": "请求分段",
      "explanationCn": "只有当段被访问且不在内存时才调入段。",
      "explanationEn": "",
      "chapterId": "ch10",
      "chapterName": "virtual memory"
    },
    {
      "id": "os-ch10-term-006",
      "termEn": "fetch paging",
      "termCn": "取页",
      "explanationCn": "指把需要的页面从外存调入内存。",
