      "chapterId": "ch08",
      "chapterName": "deadlocks"
    },
    {
      "id": "os-ch08-term-007",
      "termEn": "deadlock prevention",
      "termCn": "死锁预防",
      "explanationCn": "通过破坏死锁产生的必要条件之一来防止死锁。",
      "explanationEn": "",
