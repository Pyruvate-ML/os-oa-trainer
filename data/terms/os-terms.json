      "chapterName": "synchronization"
    },
    {
      "id": "os-ch07-term-011",
      "termEn": "Synchronization",
      "termCn": "同步",
      "explanationCn": "多个进程或线程按照一定顺序协调执行。",
      "explanationEn": "",
      "chapterId": "ch07",
      "chapterName": "synchronization"
    },
    {
