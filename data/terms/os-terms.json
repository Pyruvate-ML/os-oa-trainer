      "chapterId": "ch09",
      "chapterName": "memory management"
    },
    {
      "id": "os-ch09-term-016",
      "termEn": "frames",
      "termCn": "页框",
      "explanationCn": "物理内存中的固定大小块，与页大小相同。",
