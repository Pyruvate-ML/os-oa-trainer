{
  "subjectId": "os",
  "subjectName": "Operating Systems",
  "filename": "os-terms-vocabulary.json",
  "terms": [
    {
      "id": "os-ch01-term-001",
      "termEn": "Concurrency",
      "termCn": "并发",
      "explanationCn": "多个任务在同一时间段内交替推进，看起来像同时执行。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-002",
      "termEn": "Parallelism",
      "termCn": "并行",
      "explanationCn": "多个任务在同一时刻真正同时执行，通常需要多个处理器或多核支持。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-003",
      "termEn": "Sharing",
      "termCn": "共享",
      "explanationCn": "多个用户、进程或线程共同使用 CPU、内存、文件和 I/O 设备等系统资源。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-004",
      "termEn": "Virtual",
      "termCn": "虚拟",
      "explanationCn": "操作系统通过抽象让用户或程序看到的资源不一定等同于真实物理资源。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-005",
      "termEn": "asynchronism",
      "termCn": "异步性",
      "explanationCn": "事件发生的时间不可预知，进程执行顺序和速度不是固定的。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-006",
      "termEn": "Single batch processing",
      "termCn": "单道批处理",
      "explanationCn": "内存中一次只装入一个作业，由系统自动成批处理。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-007",
      "termEn": "Multiprogrammed batch system",
      "termCn": "多道批处理系统",
      "explanationCn": "内存中同时装入多个作业，通过作业切换提高 CPU 利用率。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-008",
      "termEn": "Multiprogramming",
      "termCn": "多道程序设计",
      "explanationCn": "多个程序同时驻留内存并交替运行，以提高系统资源利用率。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-009",
      "termEn": "time-sharing system",
      "termCn": "分时系统",
      "explanationCn": "多个用户通过时间片轮流使用 CPU，使每个用户感觉自己独占系统。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-010",
      "termEn": "real-time system",
      "termCn": "实时系统",
      "explanationCn": "系统必须在规定时间内对外部事件作出响应。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-011",
      "termEn": "distributed system",
      "termCn": "分布式系统",
      "explanationCn": "多台计算机通过网络连接并协同完成任务的系统。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-012",
      "termEn": "parallel system",
      "termCn": "并行系统",
      "explanationCn": "具有多个处理器或多个计算单元，能够同时执行多个任务的系统。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-013",
      "termEn": "interrupt",
      "termCn": "中断",
      "explanationCn": "外部事件或硬件设备向 CPU 发出的请求，使 CPU 暂停当前程序转去处理中断服务程序。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-014",
      "termEn": "trap",
      "termCn": "陷阱",
      "explanationCn": "也称软件中断，通常由程序内部事件引起，包括系统调用、缺页故障、访问越界等异常。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-015",
      "termEn": "interrupt vector",
      "termCn": "中断向量",
      "explanationCn": "保存各类中断处理程序入口地址的数据结构。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-016",
      "termEn": "interrupt handler",
      "termCn": "中断处理程序",
      "explanationCn": "用来处理中断事件的内核程序。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-017",
      "termEn": "dual-mode operation",
      "termCn": "双模式操作",
      "explanationCn": "系统区分用户态和内核态，防止用户程序直接执行危险操作。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-018",
      "termEn": "privileged instructions",
      "termCn": "特权指令",
      "explanationCn": "只能在内核态执行的指令，例如 I/O 控制、中断管理、修改页表等。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-019",
      "termEn": "system calls",
      "termCn": "系统调用",
      "explanationCn": "用户程序请求操作系统内核服务的接口。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-020",
      "termEn": "layered operating system",
      "termCn": "分层操作系统",
      "explanationCn": "把操作系统划分为若干层，每层只调用下一层提供的功能。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-021",
      "termEn": "microkernel",
      "termCn": "微内核",
      "explanationCn": "只在内核中保留最基本功能，如进程通信、基本调度和低级地址空间管理。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-022",
      "termEn": "macrokernel",
      "termCn": "宏内核",
      "explanationCn": "也称单体内核，大部分操作系统服务都运行在内核态。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch01-term-023",
      "termEn": "loadable kernel modules",
      "termCn": "可加载内核模块",
      "explanationCn": "可以在系统运行时动态加载或卸载的内核功能模块。",
      "explanationEn": "",
      "chapterId": "ch01",
      "chapterName": "basic structure"
    },
    {
      "id": "os-ch04-term-001",
      "termEn": "Process",
      "termCn": "进程",
      "explanationCn": "程序的一次执行过程，是系统进行资源分配和调度的基本单位。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-002",
      "termEn": "process state",
      "termCn": "进程状态",
      "explanationCn": "表示进程在生命周期中所处的运行阶段。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-003",
      "termEn": "new",
      "termCn": "新建态",
      "explanationCn": "进程正在被创建。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-004",
      "termEn": "ready",
      "termCn": "就绪态",
      "explanationCn": "进程已经具备运行条件，正在等待 CPU。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-005",
      "termEn": "running",
      "termCn": "运行态",
      "explanationCn": "进程正在 CPU 上执行。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-006",
      "termEn": "waiting / blocked",
      "termCn": "等待态/阻塞态",
      "explanationCn": "进程正在等待某个事件完成，例如 I/O 完成。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-007",
      "termEn": "terminated / exit",
      "termCn": "终止态",
      "explanationCn": "进程执行结束或被系统终止。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-008",
      "termEn": "ready suspended",
      "termCn": "就绪挂起态",
      "explanationCn": "进程在外存中，具备运行条件，但暂时不能进入内存运行。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-009",
      "termEn": "blocked suspended",
      "termCn": "阻塞挂起态",
      "explanationCn": "进程在外存中，并且还在等待某个事件。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-010",
      "termEn": "Process Control Block",
      "termCn": "进程控制块",
      "explanationCn": "简称 PCB，用来保存进程状态、寄存器、程序计数器、优先级、资源信息等。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-011",
      "termEn": "priority",
      "termCn": "优先级",
      "explanationCn": "用于表示进程获得 CPU 的优先程度。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-012",
      "termEn": "process schedule queue",
      "termCn": "进程调度队列",
      "explanationCn": "操作系统按不同状态组织进程的队列，例如就绪队列、等待队列。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-013",
      "termEn": "short-term scheduler",
      "termCn": "短程调度",
      "explanationCn": "也叫 CPU 调度，从就绪队列中选择一个进程运行。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-014",
      "termEn": "long-term scheduler",
      "termCn": "长程调度",
      "explanationCn": "也叫作业调度，决定哪些作业进入内存成为进程。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-015",
      "termEn": "medium-term scheduler",
      "termCn": "中程调度",
      "explanationCn": "负责进程的挂起与恢复，调节内存中进程数量。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-016",
      "termEn": "context switch",
      "termCn": "上下文切换",
      "explanationCn": "CPU 从一个进程切换到另一个进程时保存和恢复运行现场的过程。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-017",
      "termEn": "interprocess communication",
      "termCn": "进程间通信",
      "explanationCn": "简称 IPC，指进程之间交换数据和信息的机制。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-018",
      "termEn": "shared memory system",
      "termCn": "共享内存系统",
      "explanationCn": "多个进程通过共享一块内存区域进行通信。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-019",
      "termEn": "message-passing system",
      "termCn": "消息传递系统",
      "explanationCn": "进程通过发送和接收消息进行通信。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-020",
      "termEn": "thread",
      "termCn": "线程",
      "explanationCn": "进程中的一个执行流，是 CPU 调度的基本单位。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-021",
      "termEn": "single thread",
      "termCn": "单线程",
      "explanationCn": "进程中只有一个执行流。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-022",
      "termEn": "multi-thread process",
      "termCn": "多线程进程",
      "explanationCn": "一个进程中包含多个线程，这些线程共享进程资源。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-023",
      "termEn": "kernel-level thread",
      "termCn": "内核级线程",
      "explanationCn": "由操作系统内核直接管理和调度的线程。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-024",
      "termEn": "user-level thread",
      "termCn": "用户级线程",
      "explanationCn": "由用户态线程库管理，内核不知道其具体存在。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-025",
      "termEn": "many-to-one",
      "termCn": "多对一模型",
      "explanationCn": "多个用户线程映射到一个内核线程。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-026",
      "termEn": "one-to-one",
      "termCn": "一对一模型",
      "explanationCn": "一个用户线程对应一个内核线程。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-027",
      "termEn": "many-to-many",
      "termCn": "多对多模型",
      "explanationCn": "多个用户线程映射到多个内核线程。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch04-term-028",
      "termEn": "lightweight threads",
      "termCn": "轻量级线程",
      "explanationCn": "通常指比传统进程开销更小、可由内核支持调度的执行单位。",
      "explanationEn": "",
      "chapterId": "ch04",
      "chapterName": "processes and threads"
    },
    {
      "id": "os-ch06-term-001",
      "termEn": "burst time",
      "termCn": "CPU 执行时间",
      "explanationCn": "进程连续占用 CPU 的一段时间，也可称 CPU burst。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-002",
      "termEn": "nonpreemptive",
      "termCn": "非抢占式",
      "explanationCn": "进程一旦获得 CPU，除非主动放弃或结束，否则不会被强制剥夺 CPU。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-003",
      "termEn": "preemptive",
      "termCn": "抢占式",
      "explanationCn": "操作系统可以强制暂停当前进程，把 CPU 分配给其他进程。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-004",
      "termEn": "dispatcher",
      "termCn": "分派程序",
      "explanationCn": "负责把 CPU 控制权交给调度器选中的进程。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-005",
      "termEn": "scheduling criteria",
      "termCn": "调度准则",
      "explanationCn": "用于评价调度算法好坏的指标，如 CPU 利用率、吞吐量、周转时间、等待时间、响应时间。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-006",
      "termEn": "scheduling algorithm",
      "termCn": "调度算法",
      "explanationCn": "用来决定哪个进程获得 CPU 的具体方法。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-007",
      "termEn": "FCFS",
      "termCn": "先来先服务调度",
      "explanationCn": "按照进程到达顺序依次执行。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-008",
      "termEn": "SJF",
      "termCn": "短作业优先调度",
      "explanationCn": "优先选择预计运行时间最短的进程。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-009",
      "termEn": "Priority scheduling",
      "termCn": "优先级调度",
      "explanationCn": "优先选择优先级最高的进程。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-010",
      "termEn": "Round Robin",
      "termCn": "时间片轮转调度",
      "explanationCn": "每个进程依次获得一个固定长度的时间片。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-011",
      "termEn": "time quantum",
      "termCn": "时间片",
      "explanationCn": "分时系统中分配给每个进程连续运行的最大时间。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-012",
      "termEn": "multilevel queue",
      "termCn": "多级队列调度",
      "explanationCn": "把就绪队列分成多个独立队列，每个队列可以采用不同调度算法。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-013",
      "termEn": "multilevel feedback queue",
      "termCn": "多级反馈队列调度",
      "explanationCn": "进程可以在不同优先级队列之间移动，兼顾交互性和公平性。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-014",
      "termEn": "HRRN",
      "termCn": "最高响应比优先调度",
      "explanationCn": "一种非抢占式调度算法。",
      "explanationEn": "",
      "chapterId": "ch06",
      "chapterName": "CPU scheduling"
    },
    {
      "id": "os-ch06-term-015",
      "termEn": "High Response Ratio Next",
      "termCn": "最高响应比优先",
      "explanationCn": "响应比通常为（等待时间 + 服务时间）/ 服务时间。",
      "explanationEn": "",
