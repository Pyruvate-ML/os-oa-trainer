        {
          "key": "A",
          "textEn": "Swapping technology",
          "textCn": "交换技术"
        },
        {
          "key": "B",
          "textEn": "Virtualization technology",
          "textCn": "虚拟技术"
        },
        {
          "key": "C",
          "textEn": "Multiprogramming technology",
          "textCn": "多道程序设计技术"
        },
        {
          "key": "D",
          "textEn": "Offline technology",
          "textCn": "脱机技术"
